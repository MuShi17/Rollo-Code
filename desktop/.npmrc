# Electron ships a ~100MB binary that `npm install` fetches separately from the
# GitHub release CDN.  On a slow or rate-limited link that download produces no
# progress output and looks exactly like a hang, leaving node_modules complete
# except for the binary itself.  Configuring the mirror here means a fresh clone
# installs the same way without ad-hoc environment variables.
#
# `electron_mirror` is the flat key the npm config reader exposes; the installer
# reads it back as ELECTRON_MIRROR.
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/

# Registry: left at the default. Uncomment for the mainland mirror when the
# default registry is slow.
# registry=https://registry.npmmirror.com/
